// Prisma 7: the connection URL lives in `prisma.config.ts`, not here, and the
// client is generated to an explicit path rather than into node_modules.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Post views
// ---------------------------------------------------------------------------

/// Running view total per post. `slug` is the primary key so a view is a single
/// atomic upsert with no lookup first.
model PostView {
  slug      String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("post_views")
}

/// One row per (browser session, post), used to keep a reload from counting
/// twice. Sessions rather than IP addresses: an IP is personal data, is shared
/// by everyone behind a NAT or campus network, and changes as people move
/// between networks, so it both over- and under-counts.
///
/// The composite primary key is what enforces the dedup - the insert is an
/// `ON CONFLICT DO NOTHING`, and whether it wrote a row is what decides if the
/// total gets incremented.
model PostViewSession {
  sessionId String   @map("session_id")
  slug      String
  viewedAt  DateTime @default(now()) @map("viewed_at")

  @@id([sessionId, slug])
  @@index([viewedAt])
  @@map("post_view_sessions")
}

// ---------------------------------------------------------------------------
// Contact form
// ---------------------------------------------------------------------------

/// One row per contact form submission that reached the rate limit check, so
/// the limit holds across serverless instances rather than per instance.
///
/// `client_key` is a SHA-256 of the caller's IP address, never the address
/// itself, and rows older than a day are deleted as new ones arrive, so the
/// table only ever holds the last day of pseudonymous keys.
model ContactSubmission {
  id          String   @id @default(cuid())
  clientKey   String   @map("client_key")
  submittedAt DateTime @default(now()) @map("submitted_at")

  @@index([clientKey, submittedAt])
  @@index([submittedAt])
  @@map("contact_submissions")
}

// ---------------------------------------------------------------------------
// Better Auth tables
//
// The admin portal's sign-in (`src/auth.ts`). Field names are Better Auth's;
// `@map` keeps the snake_case columns, which predate it. Account holds each
// user's GitHub tokens, which the portal commits with.
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  /// GitHub username, refreshed on every sign-in
  login         String?
  role          UserRole @default(USER)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  providerId            String    @map("provider")
  accountId             String    @map("provider_account_id")
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  /// Part of Better Auth's schema; never set, as GitHub is the only sign-in
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Short-lived values Better Auth checks once. Empty, as OAuth state rides in a
/// cookie, but its Prisma adapter will not start without the table.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}
