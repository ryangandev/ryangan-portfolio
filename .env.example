RESEND_API_KEY=YOUR_RESEND_API_KEY

# Contact form addresses. Both are optional and fall back to the values baked
# into `src/actions/contact-actions.ts`.
#
# CONTACT_FROM_EMAIL defaults to `onboarding@resend.dev`, Resend's shared
# sandbox domain - it only delivers to the account owner's own address and is
# heavily rate limited. Verify a domain in Resend and set this to an address on
# it for real deliverability.
CONTACT_FROM_EMAIL="Portfolio Contact Form <contact@ryangan.me>"
CONTACT_TO_EMAIL=ryangan.dev@gmail.com

# Neon Postgres. Backs the blog post view counter (and, later, comments).
# Leave both unset and the view count is simply left out of the post metadata
# row - the site still builds and runs with no database behind it.
#
# DATABASE_URL is the *pooled* endpoint (host contains `-pooler`) and is the
# only one production needs - it is what the app uses at runtime.
#
# DATABASE_URL_UNPOOLED is the same database over the direct endpoint (same
# host without `-pooler`). Only the Prisma CLI uses it, for `db push` and
# migrations, which take advisory locks that do not survive a transaction
# pooler. Set it wherever you run those commands; if it is missing, the CLI
# falls back to DATABASE_URL so a deploy does not need it.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require

# Admin portal sign-in (Auth.js). AUTH_SECRET signs the session cookie: generate
# one with `openssl rand -base64 33`, and use a different one in production.
#
# AUTH_GITHUB_ID and AUTH_GITHUB_SECRET come from the "Ryan Gan Portfolio
# Admin" GitHub App (github.com/settings/apps/ryan-gan-portfolio-admin), which
# is installed on this repository only. Generate a separate client secret for
# each environment. Its callback URLs allow http://localhost:3000 and
# https://ryangan.me, so sign in locally on port 3000.
AUTH_SECRET=YOUR_AUTH_SECRET
AUTH_GITHUB_ID=Iv23litLXwqc1dvLVETf
AUTH_GITHUB_SECRET=YOUR_GITHUB_APP_CLIENT_SECRET

# Image uploads from the admin editor, straight from the browser to ImageKit.
# Use a restricted key that can only upload. Leave both unset and the editor
# hides its upload buttons; image URLs can still be pasted in.
IMAGEKIT_PUBLIC_KEY=YOUR_IMAGEKIT_PUBLIC_KEY
IMAGEKIT_PRIVATE_KEY=YOUR_IMAGEKIT_PRIVATE_KEY
