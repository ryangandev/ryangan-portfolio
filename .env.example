RESEND_API_KEY=YOUR_REDEND_API_KEY

# Neon Postgres. Backs the blog post view counter (and, later, comments).
# Leave both unset and the view count is simply left out of the post metadata
# row — the site still builds and runs with no database behind it.
#
# DATABASE_URL is the *pooled* endpoint (host contains `-pooler`) and is the
# only one production needs — it is what the app uses at runtime.
#
# DATABASE_URL_UNPOOLED is the same database over the direct endpoint (same
# host without `-pooler`). Only the Prisma CLI uses it, for `db push` and
# migrations, which take advisory locks that do not survive a transaction
# pooler. Set it wherever you run those commands; if it is missing, the CLI
# falls back to DATABASE_URL so a deploy does not need it.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require
